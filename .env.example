# Copy to .env and fill in. Never commit the filled-in copy.

# Postgres. DIRECT_URL bypasses the pooler for migrations.
DATABASE_URL=""
DIRECT_URL=""

# Groq — https://console.groq.com/keys
GROQ_API_KEY=""
# Optional override; defaults to openai/gpt-oss-120b in src/lib/ai.ts
# GROQ_MODEL=""

# Bearer token the /api/reorganize cron route checks. Any long random string:
#   node -e "console.log(crypto.randomUUID())"
REORGANIZE_SECRET=""
